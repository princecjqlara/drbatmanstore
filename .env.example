BOT_TOKEN=123456:replace-with-your-bot-token

# Telegram numeric user IDs that can add products and process orders.
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Comma-separated payment choices. Format: Label: instructions
# Keep private details here instead of hard-coding them in bot.py.
PAYMENT_METHODS=Crypto: Contact admin for wallet details

# Where local JSON state is stored.
STORE_DB_PATH=store_db.json

# Website dashboard login. Change this before using the dashboard publicly.
DASHBOARD_PASSWORD=change-this-password
DASHBOARD_SECRET_KEY=change-this-secret-key
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
ADMIN_CONTACT_URL=https://t.me/your_admin_username
COMMUNITY_URL=https://t.me/your_community
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
